# AutoHelp backend — copy to .env and replace placeholders.
# Never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development
# 10.0.2.2 is also added automatically in development.py for Android Emulator.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Local Docker / venv Postgres (keep these for development).
POSTGRES_DB=autohelp
POSTGRES_USER=autohelp
POSTGRES_PASSWORD=autohelp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Hosted Render Postgres. When set, this overrides POSTGRES_* above.
# Local Docker compose should leave this unset so POSTGRES_HOST=db still works.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Comma-separated origins for Expo web / local browsers. Native apps do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006,http://127.0.0.1:8081,http://127.0.0.1:8082
# Development only. Do not enable in production.
CORS_ALLOW_ALL=false

# Hosted Django Admin (must include https:// scheme). Local Admin on same host is fine without this.
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# OpenAPI / Swagger / ReDoc. Default follows DEBUG. Production must set this explicitly.
ENABLE_API_DOCS=true

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Render / production (do not use these values locally) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# SECRET_KEY=<long-random-value>
# DATABASE_URL=<render-postgres-url>
# ALLOWED_HOSTS=your-service.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
# CORS_ALLOWED_ORIGINS=
# ENABLE_API_DOCS=true
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
# RENDER_EXTERNAL_HOSTNAME is set automatically by Render.
