# AutoHelp Customer — public client configuration only.
# Copy to `.env` in this folder and restart Expo (`pnpm start`).
#
# Never put Django SECRET_KEY, Postgres passwords, JWT secrets, or staging
# user passwords in git. Phone + password are entered in the login screen.

EXPO_PUBLIC_API_URL=https://autohelp-api.onrender.com/api/v1
#
# Local Docker — Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# Host browser / Windows itself:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#
# Physical phone on the same LAN (replace with the PC's IPv4):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api/v1
#
# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#
# Do not use 127.0.0.1 inside the Android Emulator — that is the emulator
# loopback, not the Windows host. Android Emulator reaches the host at 10.0.2.2.
