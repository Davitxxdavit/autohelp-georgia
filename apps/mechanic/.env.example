# AutoHelp Mechanic — public client configuration only.
# Copy to `.env` in this folder and restart Expo.
#
# Never commit staging passwords. Sign in on the login screen.

EXPO_PUBLIC_API_URL=https://autohelp-api.onrender.com/api/v1
#
# Local Docker — Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# Windows host: http://127.0.0.1:8000/api/v1
# Physical phone: http://<LAN-IP>:8000/api/v1
